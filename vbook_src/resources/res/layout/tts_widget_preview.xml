<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@android:color/Teal_700" android:padding="16dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <FrameLayout android:background="@android:color/Red_800" android:layout_width="80dp" android:layout_height="80dp">
            <ImageView android:layout_gravity="center" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_headphones" android:tint="@android:color/Pink_800" android:contentDescription="@null"/>
        </FrameLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp">
            <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="@android:color/GM2_grey_800" android:ellipsize="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tts_widget_name" android:maxLines="2"/>
            <TextView android:textSize="13sp" android:textColor="@android:color/Pink_700" android:ellipsize="end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/tts_widget_preview_subtitle" android:maxLines="2"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1">
        <FrameLayout android:background="@android:color/Red_800" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_gravity="center" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_skip_next" android:tint="@android:color/Indigo_800" android:contentDescription="@null" android:rotation="180"/>
        </FrameLayout>
        <View android:layout_width="8dp" android:layout_height="0dp"/>
        <FrameLayout android:background="@android:color/background_floating_material_light" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_gravity="center" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_play_arrow" android:tint="@android:color/background_cache_hint_selector_material_light" android:contentDescription="@null"/>
        </FrameLayout>
        <View android:layout_width="8dp" android:layout_height="0dp"/>
        <FrameLayout android:background="@android:color/Red_800" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_gravity="center" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_skip_next" android:tint="@android:color/Indigo_800" android:contentDescription="@null"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
