<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base background (light surface/background) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?android:attr/colorBackground" />
        </shape>
    </item>

    <!-- Top Right radial glow (primary container tint) -->
    <item
        android:width="600dp"
        android:height="600dp"
        android:top="-300dp"
        android:right="-300dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:startColor="?attr/colorPrimaryContainer"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- Bottom Left radial glow (secondary container tint) -->
    <item
        android:width="600dp"
        android:height="600dp"
        android:bottom="-300dp"
        android:left="-300dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:startColor="?attr/colorSecondaryContainer"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
